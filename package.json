{
  "name": "ai-skills-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 0 asset toolchain for the AI Skills Hub WordPress theme",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./wp-content/themes/ai-skills-hub/assets/src/app.css -o ./wp-content/themes/ai-skills-hub/assets/dist/app.css --minify",
    "build:js": "esbuild ./wp-content/themes/ai-skills-hub/assets/src/app.js --bundle --minify --target=es2020 --outfile=./wp-content/themes/ai-skills-hub/assets/dist/app.js",
    "dev": "npm run build:css -- --watch",
    "dev:js": "npm run build:js -- --watch",
    "check:assets": "node scripts/check-assets.mjs",
    "lint:php": "bash scripts/lint-php.sh",
    "smoke:wp": "bash scripts/smoke-wordpress.sh",
    "test:core": "bash scripts/test-core.sh"
  },
  "devDependencies": {
    "alpinejs": "^3.14.9",
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.17"
  }
}
