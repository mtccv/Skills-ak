# Cloud development only. Generate unique random values; never commit .env.
MYSQL_DATABASE=ai_skills_hub
MYSQL_USER=aish
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Optional server-only public GitHub API credential; keep the real value in ignored Cloud .env.
AISH_GITHUB_TOKEN=
# Optional AI credentials. Profile "default" / "compatible" resolves these server-only keys.
AISH_AI_KEY_DEFAULT=
AISH_AI_KEY_COMPATIBLE=
# Comma-separated exact HTTPS API hostnames; never include private/IP/local destinations.
AISH_AI_ALLOWED_HOSTS=api.openai.com
